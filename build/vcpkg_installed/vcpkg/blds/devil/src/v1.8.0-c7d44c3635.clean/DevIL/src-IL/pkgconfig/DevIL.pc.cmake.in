prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: DevIL
Description: Developer's Image Library - DevIL part (just image load/save)
Version: @VERSION@
URL: http://openil.sourceforge.net
Cflags: -I${includedir}
Libs: -L${libdir} -lDevIL

